# LLM-Konfiguration für docker compose. Kopieren nach .env und Werte anpassen.
# .env wird nicht eingecheckt – API-Keys niemals committen.
#
# Jeder Anbieter mit OpenAI-kompatibler Chat-Completions-API funktioniert.
# Beispiele:
#   Ollama (lokal):  LLM_BASE_URL=http://host.docker.internal:11434/v1   LLM_API_KEY=            LLM_MODEL=llama3.2:3b
#   OpenAI:          LLM_BASE_URL=https://api.openai.com/v1              LLM_API_KEY=sk-...      LLM_MODEL=gpt-4o-mini
#   Anthropic:       LLM_BASE_URL=https://api.anthropic.com/v1           LLM_API_KEY=sk-ant-...  LLM_MODEL=<claude-modell>
#   Google Gemini:   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_API_KEY=...   LLM_MODEL=<gemini-modell>
#   Mistral:         LLM_BASE_URL=https://api.mistral.ai/v1              LLM_API_KEY=...         LLM_MODEL=mistral-small-latest

LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.2:3b
